                                                            {
                                                                "box": {
                                                                    "fontface": 1,
                                                                    "fontname": "Ableton Sans Medium",
                                                                    "fontsize": 15.0,
                                                                    "id": "obj-67",
                                                                    "linecount": 19,
                                                                    "maxclass": "comment",
                                                                    "numinlets": 1,
                                                                    "numoutlets": 0,
                                                                    "patching_rect": [ 344.0, 88.0, 401.0, 349.0 ],
                                                                    "text": "To fix this, we transfer the inference connections into a coll, where the index is based on the sorted connections.\nThe values associated with an index are: \n- The connection ID to append after inference (to set the matrix).\n- A gate that can be either 1 or 0. This is because we can disable inference connections from the connection manager.\nAll connections that the NN is trained on will be present in the coll, even when disabled. This way, even if we set an inference connection to none, it's possible to go back and turn it on. \n\nNote that since the elements that go into this coll are based on common elements between the sorted states list (that comes from state saving) and the dictionary, setting to Inference a connection that was not present in the training set has absolutely no effect (like it was set to none).",
                                                                    "textcolor": [ 1.0, 1.0, 1.0, 1.0 ]
                                                                }
                                                            },
                                                            {
                                                                "box": {
                                                                    "fontface": 1,
                                                                    "fontname": "Ableton Sans Medium",
                                                                    "fontsize": 15.0,
