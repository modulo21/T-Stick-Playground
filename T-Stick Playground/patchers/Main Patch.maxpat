                                                                    "linecount": 3,
                                                                    "maxclass": "comment",
                                                                    "numinlets": 1,
                                                                    "numoutlets": 0,
                                                                    "patching_rect": [ 344.0, 23.0, 401.0, 61.0 ],
                                                                    "text": "Inference is performed at high rates, and we don't want to lookup a dictionary that often. Also, the dict might be bigger because we have also the direct mapping entries.",
                                                                    "textcolor": [ 1.0, 1.0, 1.0, 1.0 ]
                                                                }
                                                            },
