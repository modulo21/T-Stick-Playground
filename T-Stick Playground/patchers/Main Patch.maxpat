                            {
                                "box": {
                                    "code": "History state(0);\r\nParam on_thresh(0.5);\r\nParam off_thresh(0.1);\r\nacc_mag = in1;\r\n\r\nif(state == 0 && acc_mag > on_thresh) {\r\n    state = 1;   \r\n}\r\nelse if(state == 1 && acc_mag < off_thresh){\r\n    state = 0;\r\n}\r\n\r\nout1 = state;",
                                    "fontface": 0,
