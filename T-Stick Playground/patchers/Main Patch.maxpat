                            {
                                "box": {
                                    "id": "obj-76",
                                    "maxclass": "newobj",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patcher": {
                                        "fileversion": 1,
                                        "appversion": {
                                            "major": 9,
                                            "minor": 1,
                                            "revision": 4,
                                            "architecture": "x64",
                                            "modernui": 1
                                        },
                                        "classnamespace": "box",
                                        "rect": [ 291.0, 288.0, 1000.0, 383.0 ],
                                        "openinpresentation": 1,
                                        "toolbars_unpinned_last_save": 15,
                                        "boxes": [
                                            {
                                                "box": {
                                                    "fontface": 1,
                                                    "fontname": "Ableton Sans Medium",
                                                    "fontsize": 15.0,
                                                    "id": "obj-5",
                                                    "linecount": 8,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 10.0, 214.0, 983.0, 151.0 ],
                                                    "presentation": 1,
                                                    "presentation_linecount": 8,
                                                    "presentation_rect": [ 8.0, 218.0, 968.0, 151.0 ],
                                                    "text": "The graphical matrix object can be used both to set permanent connections and to provide the training examples for the neural network. The neural network learns to morph between N matrix states based on the value of T-Stick input features. The matrix states to morph between are set through the graphical matrix in the following way:\n- Choose a connection state by connecting inputs to outputs, optionally deciding the gain of each connection.\n- Send that state to the NN by assigning it an ID through the \"save state\" parameter. You should see the ID displayed on the NN page under \"map state n°\".\n- Clear the matrix and set the second state; repeat for the desired number of states.\n- Once all states are set, you can use the matrix to set the permanent connections between modules.",
                                                    "textcolor": [ 1.0, 1.0, 1.0, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontface": 1,
                                                    "fontname": "Ableton Sans Medium",
                                                    "fontsize": 18.0,
                                                    "id": "obj-3",
