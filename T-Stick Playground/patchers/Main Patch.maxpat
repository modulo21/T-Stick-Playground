                                        "classnamespace": "box",
                                        "rect": [ 185.0, 353.0, 1000.0, 342.0 ],
                                        "openinpresentation": 1,
                                        "toolbars_unpinned_last_save": 15,
                                        "boxes": [
                                            {
                                                "box": {
                                                    "id": "obj-12",
                                                    "maxclass": "message",
                                                    "numinlets": 2,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
