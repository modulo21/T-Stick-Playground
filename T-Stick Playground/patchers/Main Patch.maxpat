                                            },
                                            {
                                                "box": {
                                                    "fontface": 1,
                                                    "fontname": "Ableton Sans Medium",
                                                    "fontsize": 15.0,
                                                    "id": "obj-4",
                                                    "linecount": 9,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 11.0, 85.0, 985.0, 169.0 ],
                                                    "presentation": 1,
                                                    "presentation_linecount": 10,
                                                    "presentation_rect": [ 8.0, 53.0, 968.0, 187.0 ],
                                                    "text": "The connection editor's main purpose is to directly map T-Stick features to connection gains. \nThe connection to inspect is set through the \"from\" and \"to\" menus. The \"map\" menu is used to set the map state for that connection. The options are:\n- None: the connection is not mapped.\n- Inference: the connection is predicted with the neural network. If this value is set on a connection that was not present in the model's saved states, this value will be ignored (same as \"none\"). Inferred connection values are displayed in the main matrix in purple.\n- Direct: directly map this connection to any T-Stick feature. When this value is selected, two parameters appear allowing to choose which feature to map the connection to and the gain of the connection (between -1 and 1, where negative values invert the feature curve). Directly mapped values are displayed in the connection matrix in blue. Make sure that the \"direct mapping\" gate is enabled in order for this setting to work.",
                                                    "textcolor": [ 1.0, 1.0, 1.0, 1.0 ]
                                                }
                                            },
